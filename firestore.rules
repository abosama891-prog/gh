rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isFleetAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }

    match /fleet/users {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }

    match /fleet/company {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }

    match /fleet/routes {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }

    match /fleet/deviationNotifications/items/{notificationId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }

    match /fleet/audit-logs/items/{auditId} {
      allow read: if isFleetAdmin();
      allow create: if isFleetAdmin()
        && request.resource.data.keys().hasOnly(['actorName', 'actorEmail', 'action', 'itemName', 'createdAt'])
        && request.resource.data.actorName is string
        && request.resource.data.actorEmail is string
        && request.resource.data.action in ['edit', 'delete']
        && request.resource.data.itemName is string
        && request.resource.data.createdAt is string;
      allow update, delete: if isFleetAdmin();
    }
  }
}
