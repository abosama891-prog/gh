rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /fleet/users {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }

    match /fleet/company {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }

    match /fleet/routes {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['admin@aboghaly.local', 'gh@aboghaly.local'];
    }
  }
}
